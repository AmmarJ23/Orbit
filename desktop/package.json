{
  "name": "orbit-desktop",
  "version": "0.0.3-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "dev:demo": "node scripts/tauri.mjs --demo dev",
    "dev:live": "node scripts/tauri.mjs --live dev",
    "build": "node scripts/tauri.mjs build --bundles app",
    "build:demo": "node scripts/tauri.mjs --demo build --bundles app",
    "build:live": "node scripts/tauri.mjs --live build --bundles app",
    "tauri": "node scripts/tauri.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "vite build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "vite": "8.3.4"
  }
}
